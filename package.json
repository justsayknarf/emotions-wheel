    "check:pin": "npx tsx scripts/test-pin-adjust.ts",
    "check:checkin": "npx tsx scripts/test-check-in.ts",
    "check:departure": "npx tsx scripts/test-departure.ts",
    "check:source": "npx tsx scripts/test-source.ts",
    "check:gesture": "npx tsx scripts/test-field-gesture.ts",
    "check:anchor": "npx tsx scripts/test-anchor-label.ts",
    "check:density": "npx tsx scripts/test-chart-density.ts",
    "check:tags": "npx tsx scripts/test-day-tags.ts",
    "check:landing": "npx tsx scripts/test-landing-sky.ts",
